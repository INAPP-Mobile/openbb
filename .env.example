# OpenBB Platform API — environment variables
# Single service: the OpenBB Platform REST API (FastAPI + 70+ data providers).
# Everything is OPTIONAL. The template works with zero config (free providers
# like yfinance work out of the box). Set provider API keys to unlock premium
# data sources (Polygon, FRED, Alpha Vantage, Bloomberg, etc.).

# --- Core ---
# Port the container listens on. Railpack injects this; the entrypoint maps it
# to OPENBB_API_PORT so the server binds the right port. Leave as-is.
PORT=6900

# Listen host (always 0.0.0.0 inside the container so Railway can reach it).
OPENBB_API_HOST=0.0.0.0

# Timezone for generated output / logs (IANA name).
TZ=UTC

# --- Optional: API security gate (HTTP Basic) ---
# Leave all three unset for open access (default, recommended for a private
# project). Set OPENBB_API_AUTH=true and provide credentials to require
# HTTP Basic auth on the endpoints:
# OPENBB_API_AUTH=false
# OPENBB_API_USERNAME=admin
# OPENBB_API_PASSWORD=

# --- Optional: data-provider API keys (pick the ones you have) ---
# Naming rule: OpenBB reads any env var whose name matches a provider's
# credential key (case-insensitive) or that ends in `API_KEY`. Examples:
#
# Polygon.io      -> POLYGON_API_KEY
# FRED (St. Louis Fed, free) -> FRED_API_KEY
# Alpha Vantage   -> ALPHA_VANTAGE_KEY
# Tiingo          -> TIINGO_API_KEY
# EOD Historical  -> EODHD_API_KEY
# FinancialModels -> FINANCIALMODELINGPREP_KEY / FINANCIALMODELINGPREP_SECRET
# Finnhub         -> FINNHUB_API_KEY
# Twelve Data     -> TWELVE_DATA_KEY
# Benzinga        -> BENZINGA_CLIENT_ID / BENZINGA_CLIENT_SECRET
# IEX Cloud       -> IEX_CLOUD_API_KEY
#
# Any key ending in `_API_KEY` (or a known credential name) is picked up at
# startup, so the exact spelling above is the contract. Leave blank until you
# have a key — free providers (yfinance, FRED, etc.) need none or a free key.
#
# POLYGON_API_KEY=
# FRED_API_KEY=
# ALPHA_VANTAGE_KEY=
